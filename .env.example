# ===============================================================================
# Enterprise AI-Enabled Data Platform Environment Configuration Template
# ===============================================================================

# PostgreSQL Database (Supabase / Local). POSTGRES_USER/PASSWORD are the
# superuser credentials used by pipeline scripts and Cube.js.
#
# `npm run supabase:db:reset` always resets this password back to the
# Supabase CLI's fixed local-dev default -- there's no config.toml setting
# for a custom one. Run `python3 scripts/sync_postgres_superuser_password.py`
# right after every reset to re-sync it to whatever you set below (both
# scripts/bootstrap_platform.sh and orchestration/definitions.py already do
# this automatically).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54322
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_DB=postgres

# Least-privilege Postgres role used by the MCP server and the hybrid RAG
# retriever's SQL tier (SELECT-only on financial/ref -- see
# supabase/migrations/20260807151500_create_mcp_readonly_role.sql). Deliberately
# separate from POSTGRES_USER/PASSWORD above: those tools execute
# agent/LLM-supplied SQL, so they should never hold superuser privileges even
# though the read-only-query guardrail already screens what they run. After
# setting a password here, apply it with
# `python3 scripts/configure_readonly_role.py`.
MCP_PG_READONLY_USER=mcp_readonly
MCP_PG_READONLY_PASSWORD=<YOUR_MCP_READONLY_ROLE_PASSWORD>

# OpenMetadata Catalog Server
OPENMETADATA_URL=http://127.0.0.1:8585/api/v1
OPENMETADATA_JWT_TOKEN=<YOUR_OPENMETADATA_JWT_TOKEN>

# Controls which interface openmetadata_server's port 8585 (the catalog web
# UI) binds to -- loopback by default, reachable only from the host itself,
# not the network. Set to 0.0.0.0 only if you deliberately want the UI
# reachable from other machines on your LAN (same pattern as MCP_HOST below).
OPENMETADATA_HOST=127.0.0.1

# OpenMetadata's backing MySQL database (openmetadata_db/openmetadata_server
# services in docker-compose.yml). Required — there is no default fallback.
OPENMETADATA_MYSQL_PASSWORD=<YOUR_OPENMETADATA_MYSQL_PASSWORD>

# Cube.js Open-Source Semantic Layer
CUBEJS_URL=http://127.0.0.1:4000/cubejs-api/v1/load
CUBEJS_API_SECRET=<YOUR_CUBEJS_API_SECRET>

# Neo4j Knowledge Graph Database
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<YOUR_NEO4J_PASSWORD>

# Grafana Observability Portal
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<YOUR_GRAFANA_ADMIN_PASSWORD>

# Real distributed-tracing spans (scripts/_otel_tracing.py) -- exported via
# OTLP to the otel_collector service, which forwards to tempo for storage
# and TraceQL querying through Grafana's Tempo datasource. Fails open: if
# otel_collector isn't reachable, spans are created but silently never
# exported -- a tool call never fails because of this. Set
# OTEL_TRACES_ENABLED=0 to skip creating/exporting spans entirely (e.g. if
# you don't want to run the extra otel_collector/tempo containers).
OTEL_TRACES_ENABLED=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_SERVICE_NAME=ai-dataplatform-mcp-server

# HuggingFace Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# hybrid_rag_search's vector search and re-ranking require sentence-transformers
# + torch, which mcp_server/Dockerfile.mcp does NOT install (a multi-GB image
# size/build-time cost not taken on by default). Without them, the sidecar now
# refuses to run hybrid_rag_search at all (fails closed) rather than silently
# substituting a non-semantic hash-based approximation that looks like a real
# result. Leave this unset/0 (the secure default); set to 1 only if you
# explicitly want degraded (non-semantic) retrieval instead of a hard failure
# -- every result is then tagged "embedding_mode"/"reranker_mode": "degraded"
# so it can't be mistaken for real retrieval. See scripts/_embedding_backend.py.
ALLOW_DEGRADED_EMBEDDINGS=0

# FastMCP Agentic Protocol Sidecar (SSE transport)
# Required to authenticate calls to the mcp_sidecar service (:8001/sse). In SSE
# mode the server now refuses to start at all if this is unset, rather than
# falling back to running unauthenticated — set a long random value here.
MCP_API_KEY=<YOUR_MCP_API_KEY>

# Interface the SSE endpoint binds to. Defaults to 127.0.0.1 (loopback only) if
# unset -- under docker-compose.yml's network_mode: host, that means reachable
# from the host itself but not from the network. Set to 0.0.0.0 only if you
# deliberately want the SSE endpoint reachable from other machines (MCP_API_KEY
# is still required either way).
MCP_HOST=127.0.0.1
