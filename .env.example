# ===============================================================================
# Enterprise AI-Enabled Data Platform Environment Configuration Template
# ===============================================================================
# H4 (hardening plan): every *_HOST/*_URI/*_URL default below that points at
# 127.0.0.1 is correct as written and does NOT need to change for the
# bridge-networking migration -- these are the addresses host-run scripts
# use (they still reach every service over the host's real loopback,
# because docker-compose.yml publishes each service's port to
# 127.0.0.1:<port> on the host, unchanged from before the migration) and
# the addresses a human hits directly (Neo4j Browser, Grafana, the Cube.js
# API, ...). The *containerized* services that talk to each other
# internally (mcp_sidecar, cube) do NOT read these values -- docker-compose.yml
# hardcodes their own internal env vars to real Docker service names
# (`bolt://neo4j:7687`, `http://cube:4000/...`, ...) or
# `host.docker.internal` (for the host-run Postgres) directly in each
# service's own `environment:` block, specifically so a host-oriented
# default here is never silently used inside a container where it would
# resolve to the wrong address (that container's own loopback, not the
# host's or another service's).

# PostgreSQL Database (Supabase / Local). POSTGRES_USER/PASSWORD are the
# superuser credentials used by pipeline scripts and Cube.js.
#
# `npm run supabase:db:reset` always resets this password back to the
# Supabase CLI's fixed local-dev default -- there's no config.toml setting
# for a custom one. Run `python3 scripts/sync_postgres_superuser_password.py`
# right after every reset to re-sync it to whatever you set below (both
# scripts/bootstrap_platform.sh and orchestration/definitions.py already do
# this automatically).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54322
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_DB=postgres

# Least-privilege Postgres role used by the MCP server and the hybrid RAG
# retriever's SQL tier (SELECT-only on financial/ref -- see
# supabase/migrations/20260807151500_create_mcp_readonly_role.sql). Deliberately
# separate from POSTGRES_USER/PASSWORD above: those tools execute
# agent/LLM-supplied SQL, so they should never hold superuser privileges even
# though the read-only-query guardrail already screens what they run. After
# setting a password here, apply it with
# `python3 scripts/configure_readonly_role.py`.
MCP_PG_READONLY_USER=mcp_readonly
MCP_PG_READONLY_PASSWORD=<YOUR_MCP_READONLY_ROLE_PASSWORD>

# Least-privilege Postgres role used by Cube.js's own data source connection
# (H1 -- see supabase/migrations/20260808150000_create_cube_readonly_role.sql).
# A deliberate sibling of MCP_PG_READONLY_* above, not a shared login -- two
# unrelated callers should not authenticate as the same database identity.
# After setting a password here, apply it with
# `python3 scripts/configure_readonly_role.py` (configures both roles).
CUBE_PG_READONLY_USER=cube_readonly
CUBE_PG_READONLY_PASSWORD=<YOUR_CUBE_READONLY_ROLE_PASSWORD>

# OpenMetadata Catalog Server
OPENMETADATA_URL=http://127.0.0.1:8585/api/v1
# A real, genuinely time-bounded ingestion-bot JWT (H10, hardening plan) --
# don't hand-craft this. Run `python3 scripts/rotate_openmetadata_bot_token.py`
# once OPENMETADATA_ADMIN_EMAIL/PASSWORD below are set and openmetadata_server
# is up; it mints one via OpenMetadata's own token API and writes it here for
# you. That same script is idempotent (no-ops if the current token still has
# >14 days left) and is both wired into scripts/bootstrap_platform.sh and
# scheduled daily in orchestration/definitions.py, so this shouldn't need
# manual attention in normal operation -- see that script's module docstring.
OPENMETADATA_JWT_TOKEN=<YOUR_OPENMETADATA_JWT_TOKEN>

# OpenMetadata's own local admin account (basic auth,
# AUTHENTICATION_PROVIDER=basic in docker-compose.yml). Used only by
# scripts/rotate_openmetadata_bot_token.py, to log in and mint a fresh
# ingestion-bot token -- not read by anything else. This deployment's admin
# email is always <adminPrincipals[0]>@<principalDomain>
# ("admin@openmetadata.org" for the defaults this repo ships); the password
# is whatever OpenMetadata's own bootstrap set it to (its documented default
# for a fresh basic-auth instance is "admin" -- change it via the catalog
# UI's own account settings if you've rotated it, and update this value to
# match). No fallback default here, per this repo's secrets convention --
# leaving it unset just means the rotation script can detect a token needs
# renewing but can't actually mint one, and will say so.
OPENMETADATA_ADMIN_EMAIL=admin@openmetadata.org
OPENMETADATA_ADMIN_PASSWORD=<YOUR_OPENMETADATA_ADMIN_PASSWORD>

# Controls which interface openmetadata_server's port 8585 (the catalog web
# UI) binds to -- loopback by default, reachable only from the host itself,
# not the network. Set to 0.0.0.0 only if you deliberately want the UI
# reachable from other machines on your LAN (same pattern as MCP_HOST below).
OPENMETADATA_HOST=127.0.0.1

# OpenMetadata's backing MySQL database (openmetadata_db/openmetadata_server
# services in docker-compose.yml). Required — there is no default fallback.
OPENMETADATA_MYSQL_PASSWORD=<YOUR_OPENMETADATA_MYSQL_PASSWORD>

# Cube.js Open-Source Semantic Layer
CUBEJS_URL=http://127.0.0.1:4000/cubejs-api/v1/load
# Privileged role (H1): full access, including AML-risk-restricted
# cubes/measures -- see cube/cube.js's AML_RESTRICTED_MEMBERS. Used by
# mcp_sidecar and scripts/hybrid_rag_retriever.py.
CUBEJS_API_SECRET=<YOUR_CUBEJS_API_SECRET>
# Restricted role (H1): a second, real, independently-issued token for
# general BIAN/FIBO semantic-layer access without AML risk classifications --
# see cube/cube.js's checkAuth/queryRewrite. Both must be set; Cube.js
# refuses to start authentication otherwise.
CUBEJS_API_SECRET_RESTRICTED=<YOUR_CUBEJS_API_SECRET_RESTRICTED>

# Neo4j Knowledge Graph Database
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<YOUR_NEO4J_PASSWORD>

# Grafana Observability Portal
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<YOUR_GRAFANA_ADMIN_PASSWORD>

# Real distributed-tracing spans (scripts/_otel_tracing.py) -- exported via
# OTLP to the otel_collector service, which forwards to tempo for storage
# and TraceQL querying through Grafana's Tempo datasource. Fails open: if
# otel_collector isn't reachable, spans are created but silently never
# exported -- a tool call never fails because of this. Set
# OTEL_TRACES_ENABLED=0 to skip creating/exporting spans entirely (e.g. if
# you don't want to run the extra otel_collector/tempo containers).
OTEL_TRACES_ENABLED=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_SERVICE_NAME=ai-dataplatform-mcp-server

# ===============================================================================
# LLM Provider — one switch for EVERY LLM-calling component
# ===============================================================================
# Selects the model behind the agentic tool runner, the RAG-Triad LLM judge, the
# Streamlit dashboard's grounded generation, and the E2E smoke test — all four at
# once. See scripts/_llm_backend.py.
#
#   ollama    local gemma4:latest via Ollama. Free, private, no API key.
#   moonshot  moonshotai/Kimi-K2.6 via the Moonshot API. Paid, needs a key.
#
# Fails closed: an unknown value, or `moonshot` with no API key, refuses to
# start rather than silently answering with the other provider.
LLM_PROVIDER=ollama
# Applies to both providers. A cold Ollama model load was measured at ~29s and a
# Kimi call with reasoning tokens at ~73s, so this is deliberately generous —
# the previous hardcoded 10s timeout was shorter than a normal first call.
LLM_TIMEOUT_SECONDS=120

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest

# Global endpoint. A key issued for api.moonshot.ai is rejected with HTTP 401 by
# api.moonshot.cn and vice versa — verified against both.
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2.6
MOONSHOT_API_KEY=<YOUR_MOONSHOT_API_KEY>
# Cost per 1,000 tokens for llmops_telemetry's cost accounting. Deliberately 0.0
# by default: a price hardcoded in the repo goes stale silently and would report
# confidently wrong dollar figures. Set these from Moonshot's current published
# price list to get real cost numbers; left at 0.0, the cost column honestly
# reads $0.00 rather than a fabricated estimate.
MOONSHOT_PRICE_INPUT_PER_1K=0.0
MOONSHOT_PRICE_OUTPUT_PER_1K=0.0

# HuggingFace Embedding Model. NOTE: unaffected by LLM_PROVIDER — embeddings and
# cross-encoder re-ranking always run locally via sentence-transformers, so the
# vector tier behaves identically under both providers.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# hybrid_rag_search's vector search and re-ranking require sentence-transformers
# + torch, which mcp_server/Dockerfile.mcp does NOT install (a multi-GB image
# size/build-time cost not taken on by default). Without them, the sidecar now
# refuses to run hybrid_rag_search at all (fails closed) rather than silently
# substituting a non-semantic hash-based approximation that looks like a real
# result. Leave this unset/0 (the secure default); set to 1 only if you
# explicitly want degraded (non-semantic) retrieval instead of a hard failure
# -- every result is then tagged "embedding_mode"/"reranker_mode": "degraded"
# so it can't be mistaken for real retrieval. See scripts/_embedding_backend.py.
ALLOW_DEGRADED_EMBEDDINGS=0

# FastMCP Agentic Protocol Sidecar (SSE transport)
# Required to authenticate calls to the mcp_sidecar service (:8001/sse). In SSE
# mode the server now refuses to start at all if this is unset, rather than
# falling back to running unauthenticated — set a long random value here.
MCP_API_KEY=<YOUR_MCP_API_KEY>

# H4 (hardening plan): controls which host-side interface docker-compose
# publishes the mcp_sidecar container's ports (8001 SSE, 8000 metrics) to --
# same role OPENMETADATA_HOST plays for openmetadata_server. Defaults to
# 127.0.0.1 (loopback only, reachable from the host itself but not the
# network); set to 0.0.0.0 only if you deliberately want these reachable
# from other machines (MCP_API_KEY is still required either way). This is
# NOT the mcp_sidecar container's own internal bind address anymore --
# docker-compose.yml hardcodes that to 0.0.0.0 directly (required for
# Docker's port-forwarding and for Prometheus to scrape it, now that this
# service runs on a bridge network instead of network_mode: host). If you
# run mcp_server/financial_data_mcp_server.py's SSE mode directly on a host
# instead (outside Docker), this same MCP_HOST value controls that
# process's own bind address, exactly as it always has.
MCP_HOST=127.0.0.1
