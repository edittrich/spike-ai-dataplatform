# ===============================================================================
# Enterprise AI-Enabled Data Platform Environment Configuration Template
# ===============================================================================

# PostgreSQL Database (Supabase / Local). POSTGRES_USER/PASSWORD are the
# superuser credentials used by pipeline scripts and Cube.js.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54322
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_DB=postgres

# Least-privilege Postgres role used by the MCP server and the hybrid RAG
# retriever's SQL tier (SELECT-only on financial/ref -- see
# supabase/migrations/20260807151500_create_mcp_readonly_role.sql). Deliberately
# separate from POSTGRES_USER/PASSWORD above: those tools execute
# agent/LLM-supplied SQL, so they should never hold superuser privileges even
# though the read-only-query guardrail already screens what they run. After
# setting a password here, apply it with
# `python3 scripts/configure_readonly_role.py`.
MCP_PG_READONLY_USER=mcp_readonly
MCP_PG_READONLY_PASSWORD=<YOUR_MCP_READONLY_ROLE_PASSWORD>

# OpenMetadata Catalog Server
OPENMETADATA_URL=http://127.0.0.1:8585/api/v1
OPENMETADATA_JWT_TOKEN=<YOUR_OPENMETADATA_JWT_TOKEN>

# OpenMetadata's backing MySQL database (openmetadata_db/openmetadata_server
# services in docker-compose.yml). Required — there is no default fallback.
OPENMETADATA_MYSQL_PASSWORD=<YOUR_OPENMETADATA_MYSQL_PASSWORD>

# Cube.js Open-Source Semantic Layer
CUBEJS_URL=http://127.0.0.1:4000/cubejs-api/v1/load
CUBEJS_API_SECRET=<YOUR_CUBEJS_API_SECRET>

# Neo4j Knowledge Graph Database
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<YOUR_NEO4J_PASSWORD>

# Grafana Observability Portal
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<YOUR_GRAFANA_ADMIN_PASSWORD>

# HuggingFace Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# FastMCP Agentic Protocol Sidecar (SSE transport)
# Required to authenticate calls to the mcp_sidecar service (:8001/sse). In SSE
# mode the server now refuses to start at all if this is unset, rather than
# falling back to running unauthenticated — set a long random value here.
MCP_API_KEY=<YOUR_MCP_API_KEY>

# Interface the SSE endpoint binds to. Defaults to 127.0.0.1 (loopback only) if
# unset -- under docker-compose.yml's network_mode: host, that means reachable
# from the host itself but not from the network. Set to 0.0.0.0 only if you
# deliberately want the SSE endpoint reachable from other machines (MCP_API_KEY
# is still required either way).
MCP_HOST=127.0.0.1
