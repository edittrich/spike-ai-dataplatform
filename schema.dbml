// ----------------------------------------------------------------------------
// REF SCHEMA
// ----------------------------------------------------------------------------

Table ref.ref_country {
  country_code varchar(2) [pk, note: 'ISO 3166-1 alpha-2 country code (e.g., US, DE)']
  country_name varchar(100) [not null, note: 'Official country name']
  iso_alpha3 varchar(3) [not null, note: 'ISO 3166-1 alpha-3 country code']
  iso_numeric varchar(3) [not null, note: 'ISO numeric country code']
  is_high_risk_aml boolean [not null, default: false, note: 'AML high-risk country indicator']
  created_at timestamptz [not null, default: `now()`, note: 'Record creation timestamp UTC']

  Note: 'ISO 3166-1 country reference table'
}

Table ref.ref_currency {
  currency_code varchar(3) [pk, note: 'ISO 4217 3-letter currency code (e.g., USD, EUR)']
  currency_name varchar(100) [not null, note: 'Official currency name']
  symbol varchar(10) [note: 'Currency symbol representation']
  decimal_places integer [not null, default: 2, note: 'Standard decimal precision']
  is_active boolean [not null, default: true, note: 'Active currency status indicator']
  created_at timestamptz [not null, default: `now()`, note: 'Record creation timestamp UTC']

  Note: 'ISO 4217 currency reference table'
}

Table ref.ref_nace_industry {
  nace_code varchar(10) [pk, note: 'NACE Rev. 2 industry sector code']
  nace_section varchar(1) [not null, note: 'Main section classification letter']
  nace_title varchar(255) [not null, note: 'Industry sector description title']
  risk_level varchar(20) [not null, default: 'MEDIUM', note: 'Industry risk rating (LOW, MEDIUM, HIGH)']
  created_at timestamptz [not null, default: `now()`, note: 'Record creation timestamp UTC']

  Note: 'NACE Rev. 2 industry classification reference table'
}
