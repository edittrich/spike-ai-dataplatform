  closed_date date [note: 'Account closing date']

  Indexes {
    currency_code [name: 'idx_deposit_account_currency_code']
    (md_is_active, customer_id) [name: 'idx_deposit_account_customer']
    account_number [name: 'idx_deposit_account_number']
    md_is_active [name: 'idx_deposit_account_scd_active', note: 'WHERE (md_is_active = true)']
  }

  Note: 'Deposit account core contract entity (BIAN Deposit Account) -- Constraints: CHECK ((md_valid_from_utc < md_valid_to_utc)); CHECK (((account_status)::text = ANY ((ARRAY[\'ACTIVE\'::character varying, \'DORMANT\'::character varying, \'FROZEN\'::character varying, \'CLOSED\'::character varying])::text[]))); CHECK (((account_type)::text = ANY ((ARRAY[\'SAVINGS\'::character varying, \'CHECKING\'::character varying, \'TERM_DEPOSIT\'::character varying])::text[]))); EXCLUDE USING gist (account_number WITH =, tstzrange(md_valid_from_utc, md_valid_to_utc) WITH &&)'
}

