@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Standard Ontologies
#
# D5 (hardening plan) verification pass, 2026-08-08: fibo-party:, fibo-org:,
# fibo-account:, and fibo-loan: below were corrected against the real,
# upstream FIBO ontology source (github.com/edmcouncil/fibo), fetched live
# and checked for a real owl:Class declaration at each resulting URI --
# not inferred from documentation. See
# scripts/ground_fibo_ontology_uris.py's FIBO_GROUNDING_MAP module comment
# for the full verification writeup (this file's Party/Organization/
# DepositAccount/LoanAgreement groundings had the identical wrong paths,
# independently reconciled with that map back when it and this file only
# needed to agree with *each other* -- neither had been checked against
# upstream FIBO itself until now). fibo-people:/fibo-partyrole:/bian: were
# not re-checked in this pass (fibo-people: specifically was verified via
# the FIBO_GROUNDING_MAP pass and is correct as-is).
@prefix fibo-party: <https://www.omg.org/spec/Commons/PartiesAndSituations/> .
@prefix fibo-people: <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/> .
@prefix fibo-org: <https://www.omg.org/spec/Commons/Organizations/> .
@prefix fibo-partyrole: <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Roles/> .
@prefix fibo-account: <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/> .
@prefix fibo-loan: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/> .
@prefix fibo-loanapp: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/> .
@prefix bian: <https://bian.org/ontology/v11/> .

# Local Platform Namespace
@prefix fin: <http://ai-platform.financial/ontology/v1#> .

<http://ai-platform.financial/ontology/v1> a owl:Ontology ;
    dcterms:title "BIAN & FIBO Aligned Financial Platform Ontology"@en ;
    dcterms:description "Formal W3C OWL/RDF Ontology mapping BIAN BCM and FIBO FND/FBC standards to local schema."@en ;
    owl:versionInfo "1.0.0" .

# ============================================================================
# 1. CORE CLASS HIERARCHY
# ============================================================================

fin:Party a owl:Class ;
    rdfs:label "Party Supertype"@en ;
    rdfs:comment "Master autonomous entity capable of entering into legal contracts."@en ;
    rdfs:isDefinedBy fibo-party:Party .

fin:Individual a owl:Class ;
    rdfs:subClassOf fin:Party ;
    rdfs:label "Individual Person"@en ;
    rdfs:comment "Natural person entity with legal personality."@en ;
    rdfs:isDefinedBy fibo-people:Person .

fin:Organization a owl:Class ;
    rdfs:subClassOf fin:Party ;
    rdfs:label "Organization Legal Entity"@en ;
    rdfs:comment "Corporate legal entity or partnership."@en ;
    rdfs:isDefinedBy fibo-org:LegalEntity .

fin:PartyRole a owl:Class ;
    rdfs:label "Party Role"@en ;
    rdfs:comment "Role played by a Party in a specific context."@en ;
    # D5 CAVEAT (2026-08-08): this line rides on the fibo-party: prefix fix
    # above (Party's real namespace is OMG Commons), but "PartyInRole"
    # itself was NOT independently confirmed to exist there or anywhere
    # else in FIBO -- a live search of the FIBO repository found no class
    # by this name (FND/Parties/Parties.rdf defines PartyRoleIdentifier/
    # PartyRoleIdentificationScheme, not PartyInRole). Neither the old nor
    # this new URI is confirmed correct for this specific class; treat
    # this one line as unverified pending a closer look, unlike Party/
    # Organization/DepositAccount/LoanApplication/LoanAgreement above.
    rdfs:isDefinedBy fibo-party:PartyInRole .

fin:Customer a owl:Class ;
    rdfs:subClassOf fin:PartyRole ;
    rdfs:label "Customer Role"@en ;
    rdfs:comment "Party playing the role of a banking customer."@en ;
    # Both groundings are genuinely correct -- Customer is a first-class BIAN
    # business role concept as well as a FIBO party-role concept. This used
    # to name only bian:CustomerRole here while scripts/ground_fibo_ontology_uris.py's
    # FIBO_GROUNDING_MAP (independently) grounded the same local class to
    # fibo-partyrole:Customer -- not a contradiction, just two valid
    # groundings that had drifted apart by only being recorded in one place
    # each. Listing both here keeps them from silently disagreeing again.
    rdfs:isDefinedBy bian:CustomerRole, fibo-partyrole:Customer .

fin:DepositAccount a owl:Class ;
    rdfs:label "Deposit Account"@en ;
    rdfs:comment "Checking, Savings, or Term Deposit contract."@en ;
    rdfs:isDefinedBy fibo-account:DepositAccount .

fin:DepositBalance a owl:Class ;
    rdfs:label "Deposit Balance Snapshot"@en ;
    rdfs:comment "Real-time ledger, available, and book balance state."@en .

fin:LoanApplication a owl:Class ;
    rdfs:label "Loan Application"@en ;
    rdfs:comment "Credit application request during origination."@en ;
    # D5: previously ungrounded. FIBO's real, fully-defined class for this
    # concept is LoanApplication (LOAN/LoansGeneral/LoanApplications.rdf),
    # verified live 2026-08-08 -- see scripts/ground_fibo_ontology_uris.py's
    # matching entry, which previously (wrongly) named a nonexistent
    # "CreditApplication" class instead.
    rdfs:isDefinedBy fibo-loanapp:LoanApplication .

fin:LoanAgreement a owl:Class ;
    rdfs:label "Loan Agreement Contract"@en ;
    rdfs:comment "Legally binding credit facility agreement."@en ;
    # D5: verified live 2026-08-08 -- FIBO's real class name is "Loan", not
    # "LoanAgreement" (no class by that name exists in the FIBO source);
    # corrected from fibo-loan:LoanAgreement. The fibo-loan: prefix itself
    # was also wrong (LOAN/Loans/LoansGeneral/, transposed from the real
    # LOAN/LoansGeneral/Loans/) -- see the prefix declaration's own comment.
    rdfs:isDefinedBy fibo-loan:Loan .

fin:LoanCollateral a owl:Class ;
    rdfs:label "Pledged Collateral Asset"@en ;
    rdfs:comment "Asset pledged to secure a loan facility."@en .

# ============================================================================
# 2. OBJECT PROPERTIES
# ============================================================================

fin:playsRole a owl:ObjectProperty ;
    rdfs:domain fin:Party ;
    rdfs:range fin:PartyRole ;
    rdfs:label "plays role"@en .

fin:holdsAccount a owl:ObjectProperty ;
    rdfs:domain fin:Customer ;
    rdfs:range fin:DepositAccount ;
    rdfs:label "holds deposit account"@en .

fin:hasBalanceSnapshot a owl:ObjectProperty ;
    rdfs:domain fin:DepositAccount ;
    rdfs:range fin:DepositBalance ;
    rdfs:label "has balance snapshot"@en .

fin:borrowerOf a owl:ObjectProperty ;
    rdfs:domain fin:Customer ;
    rdfs:range fin:LoanAgreement ;
    rdfs:label "is borrower of loan"@en .

fin:securedBy a owl:ObjectProperty ;
    rdfs:domain fin:LoanAgreement ;
    rdfs:range fin:LoanCollateral ;
    rdfs:label "is secured by collateral"@en .

# ============================================================================
# 3. DATATYPE PROPERTIES
# ============================================================================

fin:customerNumber a owl:DatatypeProperty ;
    rdfs:domain fin:Customer ;
    rdfs:range xsd:string ;
    rdfs:label "customer account number"@en .

fin:amlRiskRating a owl:DatatypeProperty ;
    rdfs:domain fin:Customer ;
    rdfs:range xsd:string ;
    rdfs:label "AML risk rating (LOW, MEDIUM, HIGH)"@en .

fin:availableBalance a owl:DatatypeProperty ;
    rdfs:domain fin:DepositBalance ;
    rdfs:range xsd:decimal ;
    rdfs:label "available withdrawable balance"@en .

fin:principalAmount a owl:DatatypeProperty ;
    rdfs:domain fin:LoanAgreement ;
    rdfs:range xsd:decimal ;
    rdfs:label "original loan principal amount"@en .

fin:isNpl a owl:DatatypeProperty ;
    rdfs:domain fin:LoanAgreement ;
    rdfs:range xsd:boolean ;
    rdfs:label "Non-Performing Loan default flag"@en .
