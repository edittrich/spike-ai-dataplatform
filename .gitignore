# ===============================================================================
# Supabase / Postgres, Neo4j, Cube.js -- CLI-managed local & generated state
# ===============================================================================
# Supabase CLI scratch state (regenerated by `npm run supabase:start`; the
# exact directory has moved across CLI major versions -- both are kept):
.supabase/
supabase/.temp/
supabase/.branches/
supabase/snippets/
.cube/
*.db
*.sqlite

# Docker container volumes & data directories (bind-mounted, not source)
catalog/mysql-data/
catalog/mysql-data.bak-*/
catalog/opensearch-data/
neo4j/data/
neo4j/import/
neo4j/logs/
neo4j/plugins/

# ===============================================================================
# Editors, IDEs & local agent-tool state
# ===============================================================================
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code / agentic-tool local state. Personal overrides
# (settings.local.json) and skill symlinks are both machine-specific --
# e.g. .claude/skills/*, .agents/skills/* here resolve into this machine's
# own pyenv site-packages path and would be dead links on any other checkout.
# Deliberately narrow (not `.claude/`/`.agents/` wholesale) so genuinely
# shared, team-facing config placed there later isn't swept up by accident.
.claude/settings.local.json
.claude/skills/
.agents/skills/
.mcp.json

# Other local AI-assistant generated artifacts & logs
.system_generated/
brain/
*.log
*.tmp

# ===============================================================================
# OS files
# ===============================================================================
.DS_Store
Thumbs.db
desktop.ini

